#!/usr/bin/env python3
"""Preserve an enrolled SSH identity in RAM before curtin erases its disk."""
import argparse
import hashlib
import os
from pathlib import Path
import subprocess
import sys
import tempfile

from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import rsa


def read_key(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_size > 65536:
        raise ValueError("invalid host key file")
    value = path.read_bytes()
    if value.startswith(b"-----BEGIN OPENSSH PRIVATE KEY-----"):
        key = serialization.load_ssh_private_key(value, password=None)
    else:
        key = serialization.load_pem_private_key(value, password=None)
    return key, value


def key_matches(directory, fingerprint):
    try:
        key, _ = read_key(directory / "ssh_host_rsa_key")
    except (OSError, ValueError, TypeError):
        return False
    if not isinstance(key, rsa.RSAPrivateKey) or key.key_size < 2048:
        return False
    der = key.public_key().public_bytes(
        serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo)
    return hashlib.sha256(der).hexdigest() == fingerprint


def preserve(root, output, fingerprint):
    ssh = root / "etc/ssh"
    # Refuse a symlinked directory, including an /etc symlink escaping the mount.
    if not ssh.resolve().is_relative_to(root.resolve()):
        return False
    if not key_matches(ssh, fingerprint):
        return False
    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Publish only a complete key set. A corrupt optional key must not leave a
    # seemingly reusable RSA-only directory after a failed first attempt.
    with tempfile.TemporaryDirectory(prefix=".identity-", dir=output.parent) as temp:
        staging = Path(temp) / "keys"
        staging.mkdir(mode=0o700)
        for algorithm in ("rsa", "ed25519", "ecdsa"):
            source = ssh / ("ssh_host_" + algorithm + "_key")
            if not source.exists():
                continue
            host_key, raw = read_key(source)
            target = staging / source.name
            with open(target, "xb") as stream:
                os.fchmod(stream.fileno(), 0o600)
                stream.write(raw)
            public = host_key.public_key().public_bytes(
                serialization.Encoding.OpenSSH, serialization.PublicFormat.OpenSSH)
            (staging / (source.name + ".pub")).write_bytes(public + b"\n")
        staging.rename(output)
    return True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--disk", required=True)
    parser.add_argument("--fingerprint", required=True)
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    if len(args.fingerprint) != 64 or any(c not in "0123456789abcdef" for c in args.fingerprint):
        raise ValueError("invalid fingerprint")
    disk = Path(args.disk).resolve()
    if not str(disk).startswith("/dev/") or not disk.is_block_device():
        raise ValueError("target must be a block device")
    output = Path(args.output)
    if output.exists():
        # A failed download/curtin run can retry in this same installer boot.
        # Never discard the only copy after its original partition was erased.
        if output.is_dir() and not output.is_symlink() and key_matches(output, args.fingerprint):
            return
        raise ValueError("staged identity does not match enrollment")
    # Restrict discovery to descendants of the selected installation disk.
    listing = subprocess.check_output(
        ["lsblk", "-nrpo", "NAME,TYPE,FSTYPE", str(disk)], text=True)
    with tempfile.TemporaryDirectory(prefix="gomi-identity-", dir="/run") as directory:
        root = Path(directory)
        for line in listing.splitlines():
            columns = line.split()
            if len(columns) != 3 or columns[1] not in ("part", "lvm"):
                continue
            device, _, filesystem = columns
            options = {"ext2": "ro,noload", "ext3": "ro,noload", "ext4": "ro,noload",
                       "xfs": "ro,norecovery"}.get(filesystem)
            if options is None:
                continue
            mounted = subprocess.run(["mount", "-o", options, "--", device, directory],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if mounted.returncode != 0:
                continue
            try:
                if preserve(root, output, args.fingerprint):
                    return
            finally:
                subprocess.run(["umount", "--", directory], check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    raise ValueError("enrolled key not found on installation disk")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print("cannot preserve enrolled host identity; refusing disk installation", file=sys.stderr)
        sys.exit(1)
